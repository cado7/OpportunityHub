{
  "entities": {
    "Opportunity": {
      "title": "Opportunity",
      "description": "A job, bursary, internship, or educational opportunity.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the opportunity." },
        "category": { "type": "string", "description": "Type of opportunity (Bursary, Internship, Learnership, etc.)" },
        "organization": { "type": "string", "description": "The company or institution offering it." },
        "description": { "type": "string", "description": "Detailed description of the opportunity." },
        "keyRequirements": { "type": "string", "description": "List of qualifications and skills needed." },
        "duration": { "type": "string", "description": "Length of the program." },
        "region": { "type": "string", "description": "Province or region (e.g., Gauteng)." },
        "city": { "type": "string", "description": "Specific city (optional)." },
        "closingDate": { "type": "string", "format": "date-time", "description": "Application deadline." },
        "expectedStartDate": { "type": "string", "format": "date-time", "description": "When the program begins." },
        "howToApply": { "type": "string", "description": "Step-by-step instructions." },
        "applicationLink": { "type": "string", "format": "uri", "description": "Official application URL." },
        "contactEmail": { "type": "string", "format": "email", "description": "Inquiry email." },
        "logo": { "type": "string", "format": "uri", "description": "Organization logo URL." },
        "status": { "type": "string", "enum": ["draft", "published"], "description": "Publication status." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string", "description": "UID of the admin who created this." }
      },
      "required": ["title", "category", "organization", "description", "status", "createdAt", "authorId"]
    },
    "News": {
      "title": "News",
      "description": "Career news, trends, and updates manually posted or automatically fetched.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Headline of the news article." },
        "content": { "type": "string", "description": "Full content or main body of the news." },
        "summary": { "type": "string", "description": "Brief summary for listing views." },
        "source": { "type": "string", "description": "Source of the news (e.g. SA News, NewsData.io)." },
        "url": { "type": "string", "format": "uri", "description": "Link to the original article if applicable." },
        "imageUrl": { "type": "string", "format": "uri", "description": "Header image URL." },
        "category": { "type": "string", "description": "News category like Tech, Careers, Funding." },
        "isAutoGenerated": { "type": "boolean", "description": "True if fetched via API/RSS." },
        "status": { "type": "string", "enum": ["draft", "published"], "description": "Publication status." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string", "description": "UID of the admin who posted this." }
      },
      "required": ["title", "content", "status", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User subscription to opportunity alerts.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber's email address." },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "unsubscribed"], "description": "Subscription status." }
      },
      "required": ["email", "createdAt", "status"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "User telemetry interactions logged on client side.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "path": { "type": "string" },
        "category": { "type": "string" },
        "opportunityId": { "type": "string" },
        "newsId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "path", "createdAt"]
    },
    "AnalyticsMetadata": {
      "title": "AnalyticsMetadata",
      "description": "Adjustable live base counters for performance stats.",
      "type": "object",
      "properties": {
        "totalVisitorsBase": { "type": "integer" },
        "uniqueClicksBase": { "type": "integer" },
        "avgSessionSeconds": { "type": "integer" },
        "totalSubscribersBase": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["totalVisitorsBase", "uniqueClicksBase", "avgSessionSeconds", "totalSubscribersBase"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A contact inquiry/message sent from the website contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "/contact_inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Public contact form message submissions."
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Career news and trends."
    },
    "/opportunities/{opportunityId}": {
      "schema": "Opportunity",
      "description": "Public and draft opportunities."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Alert subscriptions."
    },
    "/admins/{adminId}": {
      "schema": {
        "title": "Admin",
        "type": "object",
        "properties": {
          "email": { "type": "string" }
        }
      },
      "description": "Authorized administrators."
    },
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Live traffic tracking logs."
    },
    "/analytics_metadata/{docId}": {
      "schema": "AnalyticsMetadata",
      "description": "Live base telemetry controls."
    }
  }
}
